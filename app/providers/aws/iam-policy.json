{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ValidateCallerIdentity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "ReadEC2InventoryAndStatusInConfiguredRegions",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:DescribeInstanceStatus"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {"aws:RequestedRegion": ["us-east-1"]}
      }
    }
  ]
}
