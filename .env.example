APP_ENV=development
WEBHOOK_TOKEN=replace-with-a-long-random-secret
DATABASE_URL=postgresql://rca_engine_user:URL_ENCODED_PASSWORD@127.0.0.1:5432/rca_engine_db
APP_BIND_HOST=127.0.0.1
OPERATOR_TOKEN=
AZURE_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_IDS=
AZURE_RESOURCE_GROUPS=
AWS_ENABLED=false
AWS_ACCOUNT_IDS=
AWS_REGIONS=
AWS_INSTANCE_IDS=
RCA_PUBLIC_DOMAIN=
RCA_TLS_EMAIL=
CACHE_TTL_SECONDS=86400
CACHE_MAX_ITEMS=1000
ENABLE_DEMO_RULES=true

# Email is disabled until all required settings are supplied.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_STARTTLS=true
